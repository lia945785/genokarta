  fileOk -->|так| pick[Вибір хвороб]
  pick --> pickOk{Обрано хоча б одну?}
  pickOk -->|ні| pickError[Підказка обрати хворобу] --> pick
  pickOk -->|так| q1[Анкета: тіло і сон]
  q1 --> q2[Харчування] --> q3[Звички й активність] --> q4[Середовище]
  q4 --> allOk{Уся анкета заповнена?}
  allOk -->|ні| firstBad[Перехід на перший крок із помилкою] --> q1
  allOk -->|так, Отримати звіт| request[Запит аналізу]
  request --> report([Звіт])
